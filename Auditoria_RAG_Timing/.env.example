# Copia este archivo como .env antes de levantar la herramienta.
# Cambia las contrasenas y la clave JWT antes de usarla fuera de una prueba local.

POSTGRES_DB=auditoria_rag
POSTGRES_USER=auditoria
POSTGRES_PASSWORD=cambiar-password-postgres

DATABASE_URL=postgresql+asyncpg://auditoria:cambiar-password-postgres@postgres:5432/auditoria_rag
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=cambiar-por-una-clave-larga-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRE_MINUTES=1440
SESSION_COOKIE_SECURE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar-password-admin

DATASETS_DIR=/data/datasets
MAX_DATASET_SIZE_MB=20
MAX_QUERIES_PER_AUDIT=5000
MAX_CONCURRENT_AUDITS=2
AUDIT_JOB_TIMEOUT_SECONDS=86400

BACKEND_CORS_ORIGIN=http://localhost:5173
API_V1_PREFIX=/api/v1
VITE_API_BASE_URL=http://localhost:8000
